{
  "buildCommand": "python3 -m venv /tmp/roborab-build-venv && /tmp/roborab-build-venv/bin/pip install --quiet Pillow && /tmp/roborab-build-venv/bin/python build.py",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "roborab.vercel.app"
        }
      ],
      "destination": "https://roborab.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.roborab.com"
        }
      ],
      "destination": "https://roborab.com/:path*",
      "permanent": true
    },
    {
      "source": "/:locale(af|ar|az|be|bg|bn|ca|cs|da|de|el|en|en-gb|es|et|fa|fi|fil|fr|he|hi|hr|hu|hy|id|it|ja|ka|kk|ko|lt|lv|mr|ms|nb|nl|pl|pt|ro|ru|sk|sl|sr|sv|sw|ta|te|th|tr|uk|ur|uz|vi|zh)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:locale(af|ar|az|be|bg|bn|ca|cs|da|de|el|en|en-gb|es|et|fa|fi|fil|fr|he|hi|hr|hu|hy|id|it|ja|ka|kk|ko|lt|lv|mr|ms|nb|nl|pl|pt|ro|ru|sk|sl|sr|sv|sw|ta|te|th|tr|uk|ur|uz|vi|zh)/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:legacyChat(chat|chat\\.html)",
      "destination": "https://chat.roborab.com/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)\\.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
